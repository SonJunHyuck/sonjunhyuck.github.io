---
// Reading-progress gauge for project details. Sections are collected on the client from the
// rendered headings, so the gauge stays hidden without JavaScript.
---
<span class="gauge-anchor" data-gauge-anchor aria-hidden="true"></span>
<nav class="detail-gauge" data-detail-gauge aria-label="읽기 진행과 목차" hidden>
  <div class="gauge-bar">
    <div class="gauge-track-area" data-gauge-area>
      <div class="gauge-track" role="progressbar" aria-label="읽기 진행률" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
        <span class="gauge-fill" data-gauge-fill></span>
        <span class="gauge-ticks" data-gauge-ticks aria-hidden="true"></span>
        <span class="gauge-runner" data-gauge-runner aria-hidden="true"><img src="/favicon2.png" alt="" width="30" height="30" /></span>
      </div>
    </div>
    <button class="gauge-toggle" type="button" data-gauge-toggle aria-expanded="false" aria-controls="detail-gauge-toc" hidden>
      <span data-gauge-current>목차</span><span class="gauge-chevron" aria-hidden="true">▾</span>
    </button>
  </div>
  <ol id="detail-gauge-toc" class="gauge-toc" data-gauge-toc hidden></ol>
</nav>
<script>
  const gauge = document.querySelector<HTMLElement>('[data-detail-gauge]');
  const article = gauge?.closest<HTMLElement>('.project-detail');
  if (gauge && article) {
    const header = document.querySelector<HTMLElement>('.site-header');
    const fill = gauge.querySelector<HTMLElement>('[data-gauge-fill]')!;
    const runner = gauge.querySelector<HTMLElement>('[data-gauge-runner]')!;
    const track = gauge.querySelector<HTMLElement>('[role="progressbar"]')!;
    const ticksBox = gauge.querySelector<HTMLElement>('[data-gauge-ticks]')!;
    const toggle = gauge.querySelector<HTMLButtonElement>('[data-gauge-toggle]')!;
    const current = gauge.querySelector<HTMLElement>('[data-gauge-current]')!;
    const toc = gauge.querySelector<HTMLOListElement>('[data-gauge-toc]')!;
    const area = gauge.querySelector<HTMLElement>('[data-gauge-area]')!;
    const end = article.querySelector<HTMLElement>('.detail-pager') ?? article;
    const anchor = document.querySelector<HTMLElement>('[data-gauge-anchor]')!;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

    // Every visible h2 after the gauge is a section of the body. Details with fewer than three
    // h2s (e.g. case-study bodies written in HTML) also list the body's h3 cases, indented.
    const visibleAfterGauge = (heading: HTMLElement) =>
      Boolean(gauge.compareDocumentPosition(heading) & Node.DOCUMENT_POSITION_FOLLOWING) && !heading.closest('.visually-hidden, [hidden]') && heading.offsetParent !== null;
    const sectionHeadings = [...article.querySelectorAll<HTMLElement>('h2')].filter(visibleAfterGauge);
    const headings = sectionHeadings.length >= 3
      ? sectionHeadings
      // Only h3s that head a block (header/section/article), not labels inside diagrams.
      : [...article.querySelectorAll<HTMLElement>('h2, .story :is(header, section, article) > h3, .story > h3')].filter(visibleAfterGauge);
    headings.forEach((heading, index) => { if (!heading.id) heading.id = `detail-section-${index + 1}`; });
    const hasToc = headings.length >= 2;
    const links = headings.map((heading) => {
      const item = document.createElement('li');
      item.dataset.level = heading.tagName === 'H3' ? '3' : '2';
      const link = document.createElement('a');
      link.href = `#${encodeURIComponent(heading.id)}`;
      link.textContent = heading.textContent?.trim() ?? '';
      item.append(link);
      toc.append(item);
      return link;
    });
    const ticks = headings.map(() => ticksBox.appendChild(document.createElement('span')));
    gauge.hidden = false;
    toggle.hidden = !hasToc;
    gauge.toggleAttribute('data-has-toc', hasToc);

    let offset = 0;
    let start = 0;
    let span = 1;
    const docTop = (element: Element) => element.getBoundingClientRect().top + scrollY;
    const measure = () => {
      const headerHeight = header?.offsetHeight ?? 0;
      document.documentElement.style.setProperty('--detail-header-height', `${headerHeight}px`);
      offset = headerHeight + gauge.offsetHeight;
      headings.forEach((heading) => { heading.style.scrollMarginTop = `${offset + 16}px`; });
      // 0% when the gauge reaches the header, 100% when the end links enter the viewport bottom.
      // The anchor stays in flow while the gauge sticks, so it marks where the body starts.
      start = docTop(anchor) - headerHeight;
      span = Math.max(1, docTop(end) - innerHeight - start);
      headings.forEach((heading, index) => {
        const at = Math.min(1, Math.max(0, (docTop(heading) - offset - start) / span));
        ticks[index].style.left = `${at * 100}%`;
        ticks[index].dataset.at = String(at);
      });
      update();
    };

    let last = -1;
    let hopTimer: ReturnType<typeof setTimeout>;
    const update = () => {
      const progress = Math.min(1, Math.max(0, (scrollY - start) / span));
      const percent = Math.round(progress * 100);
      fill.style.width = `${progress * 100}%`;
      runner.style.left = `${progress * 100}%`;
      track.setAttribute('aria-valuenow', String(percent));
      ticks.forEach((tick) => tick.toggleAttribute('data-passed', Number(tick.dataset.at) <= progress + 0.001));
      gauge.toggleAttribute('data-stuck', gauge.getBoundingClientRect().top <= (header?.offsetHeight ?? 0) + 1);
      let active = -1;
      headings.forEach((heading, index) => { if (heading.getBoundingClientRect().top <= offset + 24) active = index; });
      links.forEach((link, index) => {
        if (index === active) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
      if (hasToc) current.textContent = active >= 0 ? headings[active].textContent!.trim() : '목차';
      if (percent !== last && last >= 0 && !reduced.matches) {
        runner.classList.add('is-hopping');
        clearTimeout(hopTimer);
        hopTimer = setTimeout(() => runner.classList.remove('is-hopping'), 360);
      }
      last = percent;
    };

    const setOpen = (open: boolean, returnFocus = false) => {
      if (!hasToc) return;
      toc.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      if (!open && returnFocus) toggle.focus();
    };
    toggle.addEventListener('click', () => setOpen(toc.hidden));
    area.addEventListener('click', () => setOpen(toc.hidden));
    links.forEach((link) => link.addEventListener('click', () => setOpen(false)));
    gauge.addEventListener('keydown', (event) => { if (event.key === 'Escape' && !toc.hidden) { event.stopPropagation(); setOpen(false, true); } });
    document.addEventListener('pointerdown', (event) => { if (!gauge.contains(event.target as Node)) setOpen(false); });
    gauge.addEventListener('focusout', (event) => { if (!gauge.contains(event.relatedTarget as Node)) setOpen(false); });

    let frame = 0;
    const schedule = (remeasure: boolean) => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => (remeasure ? measure() : update()));
    };
    addEventListener('scroll', () => schedule(false), { passive: true });
    addEventListener('resize', () => schedule(true));
    // Images and embeds load after first paint and shift every section, so re-measure on size changes.
    new ResizeObserver(() => schedule(true)).observe(article);
    measure();
  }
</script>
<style>
  /* Ticks and contents links are created by the script, so they need :global() to receive scoped styles. */
  .gauge-anchor { display: block; height: 0; }
  .detail-gauge { position: sticky; z-index: 15; top: var(--detail-header-height, 0px); margin: 0 0 8px; background: var(--paper); }
  .detail-gauge[hidden] { display: none; }
  .detail-gauge[data-stuck] { box-shadow: 0 1px 0 var(--line); }
  .gauge-bar { display: flex; align-items: center; gap: 16px; height: 52px; }
  .gauge-track-area { flex: 1; min-width: 0; display: flex; align-items: center; height: 100%; padding: 0 16px; }
  .detail-gauge[data-has-toc] .gauge-track-area { cursor: pointer; }
  .gauge-track { position: relative; flex: 1; height: 6px; border-radius: 999px; background: var(--line); }
  .gauge-fill { position: absolute; inset: 0 auto 0 0; width: 0; border-radius: inherit; background: var(--accent); }
  .gauge-ticks :global(span) { position: absolute; top: 50%; width: 8px; height: 8px; border: 2px solid var(--paper); border-radius: 50%; background: var(--interactive-line); transform: translate(-50%, -50%); box-sizing: content-box; }
  .gauge-ticks :global(span[data-passed]) { background: var(--accent); }
  .gauge-runner { position: absolute; z-index: 1; top: 50%; left: 0; width: 30px; height: 30px; transform: translate(-50%, -50%); }
  .gauge-runner img { display: block; width: 100%; height: 100%; border: 2px solid var(--accent); border-radius: 50%; background: var(--surface); object-fit: cover; }
  .gauge-runner.is-hopping img { animation: gauge-hop .36s ease-out; }
  @keyframes gauge-hop { 0%, 100% { transform: translateY(0); } 40% { transform: translateY(-5px); } 70% { transform: translateY(1px); } }
  .gauge-toggle { flex: none; display: inline-flex; align-items: center; gap: 8px; max-width: 40%; min-height: 40px; padding: 8px 12px; border: 1px solid var(--interactive-line); border-radius: 8px; background: var(--surface); color: var(--ink); font: 700 13px var(--sans); cursor: pointer; }
  .gauge-toggle[hidden] { display: none; }
  .gauge-toggle > span:first-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .gauge-toggle:hover { border-color: var(--accent); }
  .gauge-toggle[aria-expanded='true'] .gauge-chevron { transform: rotate(180deg); }
  .gauge-toggle:focus-visible, .gauge-toc :global(a:focus-visible) { outline: 2px solid var(--focus); outline-offset: 2px; }
  .gauge-toc { position: absolute; top: 100%; right: 0; left: 0; max-height: min(60vh, 420px); overflow-y: auto; margin: 0; padding: 8px; list-style: none; border: 1px solid var(--line); border-radius: 0 0 12px 12px; background: var(--surface); box-shadow: 0 12px 28px var(--shadow); }
  .gauge-toc[hidden] { display: none; }
  .gauge-toc :global(li[data-level='3'] a) { padding-left: 28px; font-size: 13px; }
  .gauge-toc :global(a) { display: block; padding: 10px 12px; border-radius: 6px; color: var(--body-copy); font-size: 14px; line-height: 1.5; text-decoration: none; }
  .gauge-toc :global(a:hover) { background: var(--surface-muted); color: var(--ink); }
  .gauge-toc :global(a[aria-current]) { background: var(--accent-soft); color: var(--accent-ink); font-weight: 800; }
  @media (max-width: 680px) {
    .gauge-bar { gap: 8px; height: 48px; }
    .gauge-track-area { padding: 0 14px; }
    .gauge-toggle { max-width: 45%; min-height: 36px; padding: 6px 10px; font-size: 12px; }
  }
  @media (prefers-reduced-motion: reduce) { .gauge-runner.is-hopping img { animation: none; } .gauge-chevron { transition: none; } }
</style>
