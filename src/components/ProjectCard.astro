---
import type { CollectionEntry } from 'astro:content';

interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
const { data } = project;
const groups = data.projectGroup === 'work' ? ['work', 'games'] : [data.projectGroup];
const labels = groups.map((group) => ({ work: '업무', games: '게임', research: '연구', ai: 'AI 활용' })[group]);
const tags = [...(data.aiCollaboration ? ['AI 협업'] : []), ...data.technologies.map(({ name }) => name)];
const visibleTags = tags.slice(0, 4);
---

<article class="project-card" data-category={data.category} data-project-groups={groups.join(' ')}>
  <a class="project-card-link" href={`/projects/${project.id}/`} data-project-id={project.id} aria-label={`${data.title}${data.aiCollaboration ? ', AI 협업' : ''} 상세 보기`}>
    <div class="project-visual">
      <div class="project-category-stickers">{labels.map((label) => <span>{label}</span>)}</div>
      {data.thumbnail ? <img src={data.thumbnail} alt={`${data.title} 대표 이미지`} loading="lazy" /> : <span aria-hidden="true">{data.category === 'game' ? 'GAME' : data.category === 'ai' ? 'AI 활용' : 'GRAPHICS'}</span>}
    </div>
    <div class="project-card-body">
      <h2 title={data.title}>{data.title}</h2>
      <p class="project-card-label" title={data.cardLabel ?? data.summary}>{data.cardLabel ?? data.summary}</p>
      {visibleTags.length > 0 && (
        <ul class="tag-list" aria-label="기술 스택">
          {visibleTags.map((tag, index) => <li class:list={{ 'project-ai-tag': data.aiCollaboration && index === 0 }} title={tag}>{tag}</li>)}
        </ul>
      )}
    </div>
  </a>
</article>
