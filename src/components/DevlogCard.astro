---
import type { CollectionEntry } from 'astro:content';
import TagList from './TagList.astro';

interface Props { post: CollectionEntry<'devlog'>; }
const { post } = Astro.props;
const { data } = post;
const tags = [data.category, ...(data.relatedProject ? [data.relatedProject] : []), ...data.tags];
---

<article class="devlog-card">
  <div class="devlog-meta">
    <time datetime={data.publishedAt.toISOString()}>
      {data.publishedAt.toLocaleDateString('ko-KR', { year: 'numeric', month: '2-digit', day: '2-digit' })}
    </time>
    {data.isExample && <span class="example-label">예시 콘텐츠</span>}
  </div>
  <h2>{data.title}</h2>
  <p>{data.description}</p>
  <TagList {tags} label="글 분류와 관련 프로젝트" />
  {data.notionUrl ? (
    <a class="detail-link" href={data.notionUrl} target="_blank" rel="noreferrer">
      Notion에서 자세히 보기 <span aria-hidden="true">↗</span>
    </a>
  ) : (
    <span class="pending-link">Notion 원문 링크 준비 중</span>
  )}
</article>
