---
import { getImage } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import { FEED_IMAGE_SIZE } from '../lib/feed';

interface Props { entry: CollectionEntry<'feed'>; }
const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const date = data.date.toLocaleDateString('sv-SE', { timeZone: 'Asia/Seoul' }).replaceAll('-', '.');
const image = data.image;
const coversFrame = image && image.width >= FEED_IMAGE_SIZE && image.height >= FEED_IMAGE_SIZE;
const edge = image ? Math.min(FEED_IMAGE_SIZE * 2, image.width, image.height) : 0;
const thumbnail = image ? await getImage({
  src: image,
  format: 'webp',
  ...(coversFrame ? { width: edge, height: edge, fit: 'cover', position: 'center' } : { width: Math.min(image.width, FEED_IMAGE_SIZE * 2) }),
}) : undefined;
const fullImage = image ? await getImage({ src: image, width: Math.min(image.width, 1880), format: 'webp' }) : undefined;
---

<article class="feed-card" id={entry.id} aria-labelledby={`title-${entry.id}`}>
  <header class="feed-author">
    <img class="feed-avatar" src="/favicon2.png" alt="" width="40" height="40" loading="lazy" />
    <div>
      <span class="feed-author-name">sonny (Son Junhyuck)</span>
      <a class="feed-permalink" href={`/feed/#${entry.id}`} aria-label={`${data.title} 고유 주소`}><time datetime={data.date.toISOString()}>{date}</time></a>
    </div>
  </header>
  <h2 id={`title-${entry.id}`}>{data.title}</h2>
  <div class="feed-body"><Content /></div>
  {image && thumbnail && fullImage && (
    <button
      class:list={['feed-photo', coversFrame ? 'feed-photo--cover' : 'feed-photo--contain']}
      type="button"
      aria-label={`사진 확대: ${data.imageAlt}`}
      aria-haspopup="dialog"
      aria-controls="feed-photo-dialog"
      data-feed-photo
      data-full-src={fullImage.src}
      data-alt={data.imageAlt}
      data-original-width={image.width}
      data-original-height={image.height}
    >
      <img {...thumbnail.attributes} src={thumbnail.src} alt={data.imageAlt} loading="lazy" decoding="async" />
    </button>
  )}
  {data.tags.length > 0 && <ul class="feed-tags" aria-label="태그">{data.tags.map((tag) => <li>#{tag}</li>)}</ul>}
  <a class="feed-notion-link" href={data.notionUrl} target="_blank" rel="noopener noreferrer">Notion에서 자세히 보기 ↗</a>
</article>
