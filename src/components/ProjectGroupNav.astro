---
import { projectGroups, type ProjectGroupId } from '../config/projectGroups';

interface Props { current?: ProjectGroupId; }
const { current } = Astro.props;
---

<nav class="project-group-nav" aria-label="프로젝트 목록">
  <a href="/projects/" aria-current={!current ? 'page' : undefined}>안내</a>
  {projectGroups.map((group) => (
    <a href={group.href} aria-current={current === group.id ? 'page' : undefined}>{group.label}</a>
  ))}
</nav>
