---
import { projectGroups } from '../config/projectGroups';
---

<div class="project-group-nav" role="group" aria-label="프로젝트 필터">
  <button type="button" data-project-filter="all" aria-pressed="true" aria-controls="all-projects">전체</button>
  {projectGroups.map((group) => (
    <button type="button" data-project-filter={group.id} aria-pressed="false" aria-controls="all-projects">{group.label}</button>
  ))}
</div>
