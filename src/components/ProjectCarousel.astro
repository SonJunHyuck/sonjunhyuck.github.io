---
import type { Project } from '../lib/projects';

interface Props { projects: Project[]; }
const { projects } = Astro.props;
const count = projects.length;
const hasControls = count > 1;
const positions = projects.map((_, index) => index);
if (hasControls) positions.unshift(-2, -1);
if (hasControls) positions.push(count, count + 1);
const categories = { game: '게임', graphics: '그래픽스 연구', ai: 'AI 협업' };
---

<section class="project-carousel" aria-label="프로젝트 커버" aria-roledescription="캐러셀" data-project-carousel>
  <div class="carousel-frame">
    <div class="carousel-track" id="project-slides">
      {positions.map((position) => {
        const { id, data } = projects[(position + count) % count];
        const isCopy = position < 0 || position >= count;
        const categoryId = isCopy ? undefined : `carousel-category-${id}`;
        const content = (
          <>
            <div class="carousel-media" aria-hidden="true">
              {data.thumbnail && <img src={data.thumbnail} alt="" decoding="async" fetchpriority={position === 0 ? 'high' : 'auto'} />}
            </div>
            <div class="carousel-overlay">
              <div class="carousel-caption">
                <span id={categoryId} class="carousel-category">{categories[data.category]}</span>
                <span class="carousel-title">{data.title}</span>
                <span class="carousel-cta">자세히 보기</span>
              </div>
            </div>
          </>
        );
        return isCopy ? (
          <div class="carousel-cover carousel-item" style={`--position: ${position}`} data-position={position} aria-hidden="true">{content}</div>
        ) : (
          <div class="carousel-item" style={`--position: ${position}`} data-position={position} data-slide inert={position !== 0} role="group" aria-roledescription="슬라이드" aria-label={`${position + 1} / ${count}`}>
            <a class="carousel-cover" href={`/projects/${id}/`} aria-label={`${data.title} 자세히 보기`} aria-describedby={categoryId}>{content}</a>
          </div>
        );
      })}
    </div>
  </div>
  {hasControls && (
    <div class="carousel-controls" data-carousel-controls hidden>
      <button type="button" class="carousel-preview-control" data-step="-1" aria-label="이전 프로젝트" aria-controls="project-slides"></button>
      <div class="carousel-dots" role="group" aria-label="프로젝트 선택">
        {projects.map(({ data }, index) => (
          <button type="button" class="carousel-dot" data-dot={index} aria-label={data.title} aria-current={index === 0 ? 'true' : undefined} aria-controls="project-slides"></button>
        ))}
      </div>
      <button type="button" class="carousel-preview-control" data-step="1" aria-label="다음 프로젝트" aria-controls="project-slides"></button>
    </div>
  )}
  <p class="visually-hidden" data-carousel-status role="status"></p>
</section>

<script>
  const carousel = document.querySelector<HTMLElement>('[data-project-carousel]');
  const controls = carousel?.querySelector<HTMLElement>('[data-carousel-controls]');
  if (carousel && controls) {
    const frame = carousel.querySelector<HTMLElement>('.carousel-frame')!;
    const track = carousel.querySelector<HTMLElement>('.carousel-track')!;
    const slides = [...track.querySelectorAll<HTMLElement>('[data-slide]')];
    const covers = slides.map((slide) => slide.querySelector('a')!);
    const dots = [...controls.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const status = carousel.querySelector<HTMLElement>('[data-carousel-status]')!;
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const mobile = matchMedia('(max-width: 680px)');
    const wrap = (index: number) => (index + slides.length) % slides.length;
    const trackPosition = (index: number) => `translateX(calc(${-index} * var(--slide-step)))`;
    const overlay = (position: number) => track.querySelector<HTMLElement>(`[data-position="${position}"] .carousel-overlay`)!;
    let current = 0;
    let queuedSteps = 0;
    let animations: Animation[] = [];

    const advance = () => {
      if (animations.length || !queuedSteps) return;

      const animate = !reducedMotion.matches;
      const step = animate ? Math.sign(queuedSteps) : queuedSteps;
      queuedSteps -= step;
      const next = wrap(current + step);

      track.style.transform = trackPosition(next);
      if (animate) {
        // At the ends, start at the matching preview copy so the track still moves one step.
        const from = next - step;
        const timing = { duration: 320, easing: 'ease-in-out' };
        animations = [
          track.animate([{ transform: trackPosition(from) }, { transform: trackPosition(next) }], timing),
          overlay(from).animate([{ opacity: 1 }, { opacity: 0 }], timing),
          overlay(next).animate([{ opacity: 0 }, { opacity: 1 }], timing),
        ];
        animations[0].onfinish = () => {
          animations = [];
          advance();
        };
      }

      const moveFocus = document.activeElement === covers[current];
      slides[next].inert = false;
      if (moveFocus) covers[next].focus({ preventScroll: true });
      slides[current].inert = true;
      dots[current].removeAttribute('aria-current');
      dots[next].setAttribute('aria-current', 'true');
      current = next;
      if (!moveFocus) status.textContent = `${dots[current].getAttribute('aria-label')} (${current + 1}/${slides.length})`;
    };

    const queueStep = (step: number) => {
      // A full turn of pending input lands on the same cover.
      queuedSteps = (queuedSteps + step) % slides.length;
      advance();
    };

    dots.forEach((dot, index) => dot.addEventListener('click', () => {
      queuedSteps = index - current;
      if (Math.abs(queuedSteps) > slides.length / 2) {
        queuedSteps -= Math.sign(queuedSteps) * slides.length;
      }
      advance();
    }));
    controls.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((button) => {
      button.addEventListener('click', () => queueStep(Number(button.dataset.step)));
    });

    let swipeStart: Touch | null = null;
    frame.addEventListener('touchstart', (event) => {
      swipeStart = mobile.matches && event.touches.length === 1 ? event.touches[0] : null;
    }, { passive: true });
    frame.addEventListener('touchcancel', () => { swipeStart = null; });
    frame.addEventListener('touchend', (event) => {
      const start = swipeStart;
      swipeStart = null;
      const end = event.changedTouches[0];
      if (!start || !end || start.identifier !== end.identifier || event.touches.length) return;

      const dx = end.clientX - start.clientX;
      const dy = end.clientY - start.clientY;
      if (Math.abs(dx) < 48 || Math.abs(dx) <= Math.abs(dy) * 1.35) return;

      // A swipe changes slides without following the cover link.
      if (event.cancelable) event.preventDefault();
      queueStep(dx < 0 ? 1 : -1);
    }, { passive: false });

    carousel.addEventListener('keydown', (event) => {
      if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      queueStep(event.key === 'ArrowLeft' ? -1 : 1);
    });
    reducedMotion.addEventListener('change', () => {
      if (reducedMotion.matches) animations.forEach((animation) => animation.finish());
    });
    controls.hidden = false;
  }
</script>

<style>
  .project-carousel {
    --cover-width: min(86vw, 1280px, calc(100% - 124px));
    --slide-gap: clamp(12px, 1.4vw, 20px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--cover-width) minmax(0, 1fr);
    padding-top: clamp(24px, 3.4vw, 48px);
  }
  .carousel-frame {
    grid-area: 1 / 1 / 2 / -1;
    overflow: clip;
  }
  .carousel-track {
    --slide-step: calc(100% + var(--slide-gap));
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    width: var(--cover-width);
    margin-inline: auto;
  }
  .carousel-item {
    grid-area: 1 / 1;
    transform: translateX(calc(var(--position) * var(--slide-step)));
  }
  .carousel-cover {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 18px;
    background: var(--media-neutral);
    aspect-ratio: 2.12 / 1;
  }
  .carousel-cover:focus-visible { outline-offset: -5px; }
  .carousel-media, .carousel-overlay {
    position: absolute;
    inset: 0;
  }
  .carousel-media > img, .carousel-media > video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 38%;
  }
  .carousel-overlay {
    --scrim-stop: 38%;
    background: linear-gradient(180deg, transparent 12%, rgb(0 0 0 / .62) var(--scrim-stop), rgb(0 0 0 / .84));
    color: #fff;
    opacity: 0;
    text-align: center;
  }
  [data-slide]:not([inert]) .carousel-overlay { opacity: 1; }
  .carousel-caption {
    position: absolute;
    inset: auto 16px 16%;
    display: grid;
    justify-items: center;
    gap: clamp(6px, .8vw, 12px);
    text-shadow: 0 1px 4px rgb(0 0 0 / .55);
  }
  .carousel-category { font-size: clamp(.75rem, 1vw, .875rem); font-weight: 600; }
  .carousel-title {
    font-size: clamp(1.5rem, 4.8vw, 4rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -.03em;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }
  .carousel-cta {
    margin-top: clamp(2px, .6vw, 8px);
    padding: 9px 24px;
    border-radius: 999px;
    background: rgb(55 55 57 / .85);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / .18);
    font-size: .875rem;
    font-weight: 700;
    line-height: 1.3;
    text-shadow: none;
  }
  .carousel-cover:hover .carousel-cta,
  .carousel-cover:focus-visible .carousel-cta { background: rgb(65 65 67 / .94); }
  .carousel-controls { display: contents; }
  .carousel-dots {
    grid-area: 2 / 2;
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: 10px;
  }
  .carousel-dot {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    font: inherit;
    cursor: pointer;
  }
  .carousel-preview-control {
    grid-row: 1;
    z-index: 1;
    display: grid;
    place-items: center;
    width: min(1280px, calc(100% - var(--slide-gap)));
    padding: 0;
    border: 0;
    background: rgb(0 0 0 / .28);
    color: #fff;
    cursor: pointer;
  }
  .carousel-preview-control[data-step='-1'] {
    grid-column: 1;
    justify-self: end;
    margin-inline-end: var(--slide-gap);
    border-radius: 0 18px 18px 0;
  }
  .carousel-preview-control[data-step='1'] {
    grid-column: 3;
    justify-self: start;
    margin-inline-start: var(--slide-gap);
    border-radius: 18px 0 0 18px;
  }
  .carousel-preview-control::before {
    width: 15px;
    height: 15px;
    border-top: 1.5px solid currentColor;
    border-right: 1.5px solid currentColor;
    transform: translateX(-3px) rotate(45deg);
    filter: drop-shadow(0 0 2px #000) drop-shadow(0 0 4px #000);
    opacity: 0;
    content: '';
  }
  .carousel-preview-control[data-step='-1']::before { transform: translateX(3px) rotate(-135deg); }
  .carousel-preview-control:is(:hover, :focus-visible) { background: transparent; }
  .carousel-preview-control:is(:hover, :focus-visible)::before { opacity: 1; }
  .carousel-preview-control:focus-visible { outline-offset: -4px; }
  @media (prefers-reduced-motion: no-preference) {
    .carousel-preview-control { transition: background-color 160ms ease; }
    .carousel-preview-control::before { transition: opacity 160ms ease; }
  }
  .carousel-dot:hover { color: var(--ink); }
  .carousel-dot::before {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: currentColor;
    content: '';
  }
  .carousel-dot[aria-current='true'] { color: var(--accent); }
  .carousel-dot[aria-current='true']::before { width: 24px; }
  [hidden] { display: none; }
  @media (max-width: 680px) {
    .project-carousel { --cover-width: 100%; margin-inline: 16px; }
    .carousel-frame { touch-action: pan-y pinch-zoom; }
    .carousel-cover { aspect-ratio: 3 / 2; border-radius: 16px; }
    .carousel-overlay { --scrim-stop: 28%; }
    .carousel-caption { inset-block-end: 12%; }
    .carousel-preview-control { display: none; }
  }
</style>
