---
import { getCollection } from 'astro:content';
import { NOTION_DEVLOG_URL } from '../config/links';

const { currentPath = '/' } = Astro.props;
const detailSlug = currentPath.match(/^\/projects\/([^/]+)\/?$/)?.[1];
const detailProject = detailSlug
  ? (await getCollection('projects', ({ data }) => !data.draft)).find((project) => project.id === detailSlug)
  : undefined;
const activeProjectGroup = detailProject?.data.projectGroup;
const projectLinks = [
  { href: '/projects/work/', label: '업무경험', section: 'work' },
  { href: '/projects/games/', label: '게임', section: 'games' },
  { href: '/projects/research/', label: '연구', section: 'research' },
];

const isCurrent = (section?: string) => {
  if (section === 'profile') return currentPath === '/';
  if (section === 'work' || section === 'games' || section === 'research') {
    return currentPath.startsWith(`/projects/${section}/`) || activeProjectGroup === section;
  }
  return false;
};
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="손준혁 프로필 페이지">
      <span class="brand-mark" aria-hidden="true"><img src="/favicon.png" alt="" /></span>
      <span>Son Junhyuck</span>
    </a>
    <div class="header-actions">
      <nav aria-label="주요 탐색">
        <ul>
          <li><a href="/" aria-current={isCurrent('profile') ? 'page' : undefined}><span class="nav-label">프로필</span></a></li>
          <li class="project-navigation">
            <a href="/projects/" class:list={['project-toggle', { 'is-current': currentPath.startsWith('/projects/') }]} aria-current={currentPath === '/projects/' ? 'page' : undefined} aria-expanded="false" aria-controls="project-navigation-links">
              <span class="nav-label">프로젝트</span>
            </a>
            <ul id="project-navigation-links" class="project-dropdown" hidden>
              {projectLinks.map((link) => (
                <li><a href={link.href} aria-current={isCurrent(link.section) ? 'page' : undefined}>{link.label}</a></li>
              ))}
            </ul>
          </li>
          <li><a href={NOTION_DEVLOG_URL} target="_blank" rel="noopener noreferrer" aria-label="개발일지를 Notion에서 새 탭으로 열기"><span class="nav-label">개발일지 ↗</span></a></li>
        </ul>
      </nav>
      <div class="theme-switcher" role="group" aria-label="색상 테마 선택">
        <button type="button" data-theme-value="light" aria-pressed="false">Light</button>
        <button type="button" data-theme-value="dark" aria-pressed="false">Dark</button>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const storageKey = 'portfolio-theme';
    const themes = ['light', 'dark'];
    const buttons = document.querySelectorAll('[data-theme-value]');
    const themeColor = document.querySelector('meta[name="theme-color"]');
    const themeColors = { light: '#f5f5f7', dark: '#121212' };

    const applyTheme = (theme, persist = false) => {
      const nextTheme = themes.includes(theme) ? theme : 'light';
      document.documentElement.dataset.theme = nextTheme;
      document.documentElement.style.colorScheme = nextTheme === 'dark' ? 'dark' : 'light';
      themeColor?.setAttribute('content', themeColors[nextTheme]);
      buttons.forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.themeValue === nextTheme));
      });

      if (persist) {
        try {
          localStorage.setItem(storageKey, nextTheme);
        } catch {
          // The selected theme still applies for this page when storage is blocked.
        }
      }
    };

    applyTheme(document.documentElement.dataset.theme || 'light');
    buttons.forEach((button) => {
      button.addEventListener('click', () => applyTheme(button.dataset.themeValue, true));
    });
  })();
</script>

<style>
  nav > ul { align-items: center; }
  nav > ul > li > a { display: block; line-height: 1.5; border-bottom: 1px solid transparent; }
  nav > ul > li > a[aria-current='page'] { border-bottom-color: var(--ink); }
  .nav-label { display: block; white-space: nowrap; }
  .project-navigation { position: relative; }
  .project-toggle.is-current { color: var(--ink); border-bottom: 1px solid var(--ink); }
  .project-dropdown { position: absolute; top: calc(100% + 10px); left: 50%; transform: translateX(-50%); z-index: 1; display: flex; align-items: center; flex-wrap: nowrap; justify-content: flex-start; gap: 18px; width: max-content; padding: 12px 16px; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); box-shadow: 0 8px 24px var(--shadow); }
  .project-dropdown::before { content: ''; position: absolute; top: -12px; left: 0; width: 100%; height: 12px; }
  .project-dropdown[hidden] { display: none; }
  .project-dropdown a { display: block; white-space: nowrap; }
  .project-toggle:focus-visible, .project-dropdown a:focus-visible { outline: 2px solid var(--focus); outline-offset: 4px; }
  @media (max-width: 680px) {
    .header-actions nav .project-dropdown { gap: 14px; padding: 10px 12px; }
  }
  @media (hover: none) {
    nav > ul { margin-bottom: 48px; }
    .project-dropdown { top: 100%; }
  }
</style>

<script is:inline>
  (() => {
    const navigation = document.querySelector('.project-navigation');
    const toggle = navigation?.querySelector('.project-toggle');
    const dropdown = navigation?.querySelector('.project-dropdown');
    if (!navigation || !toggle || !dropdown) return;
    const touch = window.matchMedia('(hover: none)');
    const setOpen = (open) => {
      const expanded = touch.matches || open;
      toggle.setAttribute('aria-expanded', String(expanded));
      dropdown.hidden = !expanded;
    };
    navigation.addEventListener('mouseenter', () => setOpen(true));
    navigation.addEventListener('mouseleave', () => setOpen(navigation.contains(document.activeElement)));
    navigation.addEventListener('focusin', () => setOpen(true));
    navigation.addEventListener('focusout', (event) => {
      if (!navigation.contains(event.relatedTarget)) setOpen(navigation.matches(':hover'));
    });
    navigation.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !dropdown.hidden && !touch.matches) {
        toggle.focus();
        setOpen(false);
      }
    });
    touch.addEventListener('change', () => setOpen(false));
    setOpen(false);
  })();
</script>
