---
import { NOTION_DEVLOG_URL } from '../config/links';

const { currentPath = '/' } = Astro.props;
const links = [
  { href: '/', label: 'About' },
  { href: '/projects/', label: 'Projects' },
  { href: NOTION_DEVLOG_URL, label: 'DevLog ↗', external: true },
];

const isCurrent = (href: string) => href === '/'
  ? currentPath === '/'
  : currentPath.startsWith(href);
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Son Junhyuck 소개 페이지">
      <span class="brand-mark" aria-hidden="true"><img src="/favicon.png" alt="" /></span>
      <span>Son Junhyuck</span>
    </a>
    <nav aria-label="Primary navigation">
      <ul>
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
              aria-label={link.external ? 'DevLog를 Notion에서 새 탭으로 열기' : undefined}
              aria-current={!link.external && isCurrent(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
