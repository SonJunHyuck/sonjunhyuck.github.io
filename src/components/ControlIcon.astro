---
interface Props { name: 'close' | 'arrow-left' | 'arrow-right'; }
const { name } = Astro.props;
const paths = {
  close: 'm6 6 12 12M6 18 18 6',
  'arrow-left': 'M19 12H5m7-7-7 7 7 7',
  'arrow-right': 'M5 12h14m-7-7 7 7-7 7',
};
---
<svg class="control-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={paths[name]} /></svg>
<style>
  .control-icon { display: block; flex: none; }
</style>
