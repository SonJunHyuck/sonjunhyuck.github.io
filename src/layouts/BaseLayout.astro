---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  redirectTo?: string;
}

const { title, description = 'Son Junhyuck의 게임 개발 포트폴리오', redirectTo } = Astro.props;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fbfaf6" />
    <link rel="canonical" href={new URL(redirectTo ?? Astro.url.pathname, Astro.site)} />
    {redirectTo && <meta http-equiv="refresh" content={`0;url=${redirectTo}`} />}
    <title>{title}</title>
  </head>
  <body>
    <Header currentPath={Astro.url.pathname} />
    <main><slot /></main>
    <Footer />
  </body>
</html>
