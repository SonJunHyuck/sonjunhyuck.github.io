---
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  const legacyPostSlugs = [
    'building-a-portfolio-that-feels-human',
    'astro-github-pages-start',
    'small-interactions-big-feeling',
  ];
  return legacyPostSlugs.map((slug) => ({ params: { slug } }));
}

---

<BaseLayout title="DevLog — Son Junhyuck" description="DevLog 경로가 변경되었습니다." redirectTo="/devlog/">
  <section class="redirect-page container">
    <p class="eyebrow">DEVLOG</p>
    <h1>이전 개발 기록 경로가 변경되었습니다.</h1>
    <p><a class="detail-link" href="/devlog/">DevLog로 이동 →</a></p>
  </section>
</BaseLayout>
