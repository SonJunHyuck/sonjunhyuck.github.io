---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { NOTION_DEVLOG_URL } from '../../config/links';

export function getStaticPaths() {
  const legacyPostSlugs = [
    'building-a-portfolio-that-feels-human',
    'astro-github-pages-start',
    'small-interactions-big-feeling',
  ];
  return legacyPostSlugs.map((slug) => ({ params: { slug } }));
}

---

<BaseLayout title="개발일지 — Son Junhyuck" description="개발 기록은 Notion으로 이전되었습니다." redirectTo={NOTION_DEVLOG_URL}>
  <section class="redirect-page container">
    <p class="eyebrow">DEVLOG</p>
    <h1>이 개발 기록은<br /><em>Notion으로 이전되었습니다.</em></h1>
    <p><a class="detail-link" href={NOTION_DEVLOG_URL}>Notion 개발일지로 이동 ↗</a></p>
  </section>
</BaseLayout>
