---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { posts } from '../../data/posts';
---

<BaseLayout title="Devlog — Sonny Smile" description="Sonny Smile의 개발과 디자인 기록">
  <section class="page-intro container"><p class="eyebrow">DEVLOG</p><h1>만드는 과정에서<br /><em>발견한 것들.</em></h1><p>개발, 디자인, 그리고 더 나은 디지털 경험에 관한 기록입니다.</p></section>
  <section class="container post-list post-list-large">
    {posts.map((post) => <a class="post-row" href={`/posts/${post.slug}/`}><span class="post-meta">{post.tag} · {post.date}</span><div><h2>{post.title}</h2><p>{post.excerpt}</p></div><span aria-hidden="true">↗</span></a>)}
  </section>
</BaseLayout>
