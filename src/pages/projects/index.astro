---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectGroupNav from '../../components/ProjectGroupNav.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import IntroHex from '../../components/IntroHex.astro';
import ProfileCharacter from '../../components/ProfileCharacter.astro';
import ProjectQuickView from '../../components/ProjectQuickView.astro';
import { getOrderedProjects } from '../../lib/projects';

const projects = await getOrderedProjects();
---
<BaseLayout title="Projects — Son Junhyuck" description="업무와 개인 프로젝트를 소개합니다." next={{ href: '/feed/', title: '피드', image: '/favicon2.png' }}>
  <h1 class="visually-hidden">프로젝트</h1>
  <section class="container project-work-style" aria-labelledby="work-style-heading">
    <h2 id="work-style-heading" class="visually-hidden">이렇게 일합니다</h2>
    <div class="project-work-style-layout">
      <IntroHex instanceId="work-style">
        <ProfileCharacter eager />
      </IntroHex>
    </div>
  </section>
  <section class="page-intro container project-hub-intro">
    <ProjectGroupNav />
  </section>
  <section class="container projects-section project-list-section" aria-labelledby="project-list-heading">
    <h2 id="project-list-heading" class="visually-hidden">전체 프로젝트 목록</h2>
    <div id="all-projects" class="project-list-grid project-list-surface" role="region" aria-label="전체 프로젝트 목록">
      {projects.map((project) => <ProjectCard {project} />)}
    </div>
    <p id="project-filter-status" class="visually-hidden" role="status" aria-live="polite"></p>
    <p id="project-filter-empty" class="empty-state" hidden>이 분류의 프로젝트를 준비하고 있습니다.</p>
  </section>
  <ProjectQuickView {projects} />
</BaseLayout>

<script>
  import { projectGroups } from '../../config/projectGroups';

  const list = document.querySelector<HTMLElement>('#all-projects');
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-project-filter]')];
  const cards = [...document.querySelectorAll<HTMLElement>('#all-projects [data-project-groups]')];
  const status = document.querySelector<HTMLElement>('#project-filter-status');
  const empty = document.querySelector<HTMLElement>('#project-filter-empty');
  const validFilters: string[] = ['all', ...projectGroups.map((group) => group.id)];
  const applyFilter = () => {
    const requested = new URL(location.href).searchParams.get('filter') || 'all';
    const filter = validFilters.includes(requested) ? requested : 'all';
    let count = 0;
    cards.forEach((card) => {
      card.hidden = filter !== 'all' && !card.dataset.projectGroups?.split(' ').includes(filter);
      if (!card.hidden) count++;
    });
    buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.projectFilter === filter)));
    const label = buttons.find((button) => button.dataset.projectFilter === filter)?.textContent?.trim() || '전체';
    if (list) {
      list.setAttribute('aria-label', `${label} 프로젝트 목록`);
      list.hidden = count === 0;
    }
    if (empty) empty.hidden = count > 0;
    if (status) status.textContent = `${label} 프로젝트 ${count}개`;
    document.querySelectorAll<HTMLAnchorElement>('.project-dropdown a').forEach((link) => {
      if (new URL(link.href).searchParams.get('filter') === filter) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    });
  };
  buttons.forEach((button) => button.addEventListener('click', () => {
    const url = new URL(location.href);
    const filter = button.dataset.projectFilter || 'all';
    if (filter === 'all') url.searchParams.delete('filter');
    else url.searchParams.set('filter', filter);
    if (url.href !== location.href) history.pushState(null, '', url);
    applyFilter();
  }));
  window.addEventListener('popstate', applyFilter);
  applyFilter();
</script>
