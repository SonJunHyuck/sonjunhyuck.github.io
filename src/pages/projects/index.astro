---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCarousel from '../../components/ProjectCarousel.astro';
import ProjectShowcase from '../../components/ProjectShowcase.astro';
import { getOrderedProjects, getProjectListDestination } from '../../lib/projects';

const projects = await getOrderedProjects('projects');
const next = await getProjectListDestination('ai');
---
<BaseLayout title="Projects — Son Junhyuck" description="개인 게임과 그래픽스 연구 프로젝트를 소개합니다." {next}>
  <h1 class="visually-hidden">프로젝트</h1>
  {projects.length > 0 && (
    <>
      <ProjectCarousel {projects} />
      <ProjectShowcase {projects} />
    </>
  )}
</BaseLayout>
