---
import { getCollection } from 'astro:content';
import ProjectGroupPage from '../../components/ProjectGroupPage.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft && data.projectGroup === 'research'))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---

<ProjectGroupPage groupId="research" {projects} />
