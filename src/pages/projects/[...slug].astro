---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() { return (await getCollection('projects', ({ data }) => !data.draft)).map((project) => ({ params: { slug: project.id }, props: { project } })); }
const { project } = Astro.props;
const { Content } = await render(project);
const { data } = project;
const isProjectR = project.id === 'project-r';
const isInspixWorld = project.id === 'inspix-world';
const isHiddenCheerSquad = project.id === 'the-hidden-cheer-squad';
const isPersonalResearch = project.id === 'crowd-formation-control' || project.id === 'wind-map-simulation';
const usesCaseStudyLayout = isProjectR || isInspixWorld || isHiddenCheerSquad || isPersonalResearch;
const showsRepresentativeMedia = !usesCaseStudyLayout || isHiddenCheerSquad || isPersonalResearch;
---
<BaseLayout title={data.title} description={data.summary}>
  <article class:list={["project-detail", "container", { "case-study-detail": usesCaseStudyLayout, "inspix-world-detail": isInspixWorld }]}>
    <a class="back-link" href="/projects/">← Projects</a>
    <header><p class="eyebrow">{data.category === 'game' ? 'GAME' : 'GRAPHICS'} PROJECT {data.isExample && '· EXAMPLE'}</p><h1>{data.title}</h1><p class="lead">{data.description}</p></header>
    {data.thumbnail && <img class="project-cover" src={data.thumbnail} alt={`${data.title} 대표 이미지`} />}
    <dl class="facts">
      {data.period && <div><dt>기간</dt><dd>{data.period}</dd></div>}
      {data.role && <div><dt>역할</dt><dd>{data.role}</dd></div>}
      {(data.teamSize || data.team) && <div><dt>팀 규모</dt><dd>{data.teamSize ?? data.team}</dd></div>}
      {data.platform.length > 0 && <div><dt>플랫폼</dt><dd>{data.platform.join(' · ')}</dd></div>}
    </dl>
    {showsRepresentativeMedia && data.videos.length > 0 && <section aria-labelledby="project-videos"><p class="eyebrow">MEDIA</p><h2 id="project-videos">대표 미디어</h2><div class="video-grid">{data.videos.map((video) => <article class="video-item"><div class="video"><iframe src={`https://www.youtube-nocookie.com/embed/${video.youtubeId}`} title={video.title} loading="lazy" allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen /></div><h3>{video.title}</h3>{video.description && <p>{video.description}</p>}<a href={video.url} target="_blank" rel="noopener noreferrer">YouTube에서 보기 ↗</a></article>)}</div></section>}
    {!usesCaseStudyLayout && data.gallery.length > 0 && <section><h2>Gallery</h2><div class="gallery">{data.gallery.map((image) => <figure><img src={image.src} alt={image.alt} loading="lazy" />{image.caption && <figcaption>{image.caption}</figcaption>}</figure>)}</div></section>}
    {!usesCaseStudyLayout && <section><p class="eyebrow">TECH STACK</p><h2>사용 기술</h2><ul class="tech">{data.technologies.map((tech) => <li><strong>{tech.name}</strong><span>{tech.purpose}</span></li>)}</ul></section>}
    <section><p class="eyebrow">CONTRIBUTION</p><h2>{usesCaseStudyLayout ? '구현 및 기여' : '본인 기여 · 핵심 구현'}</h2><div class:list={["feature-grid", { "feature-grid-wide": usesCaseStudyLayout }]}>{data.features.map((feature) => <div><h3>{feature.title}</h3><p>{feature.description}</p></div>)}</div></section>
    {!usesCaseStudyLayout && data.challenges.length > 0 && <section><h2>문제 해결</h2><div class="challenges">{data.challenges.map((item) => <article><h3>{item.problem}</h3><p><strong>해결:</strong> {item.solution}</p>{item.result && <p><strong>결과:</strong> {item.result}</p>}</article>)}</div></section>}
    <section class:list={["story", { "case-study-story": usesCaseStudyLayout }]}><Content /></section>
    <div class="links">{data.repositoryUrl && <a class="button button-primary" href={data.repositoryUrl} target="_blank" rel="noreferrer">GitHub ↗</a>}{data.playableUrl && <a class="button button-outline" href={data.playableUrl} target="_blank" rel="noreferrer">실행·다운로드 ↗</a>}{data.notionUrl && <a class="button button-outline" href={data.notionUrl} target="_blank" rel="noreferrer">Notion 기록 ↗</a>}{data.externalLinks.map((link) => <a class="button button-outline" href={link.url} target="_blank" rel="noreferrer">{link.label} ↗</a>)}</div>
  </article>
</BaseLayout>

<style>
  .project-detail { max-width: 920px; padding-top: 64px; padding-bottom: 120px; }.case-study-detail { max-width: 1120px; }.project-detail header { padding: 72px 0 44px; }.project-detail h1 { max-width: 100%; }.lead { max-width: 720px; color: var(--muted); font-size: 1.2rem; line-height: 1.75; word-break: keep-all; overflow-wrap: break-word; }.case-study-detail .lead { max-width: none; }.project-cover { width: 100%; max-height: 560px; object-fit: cover; border-radius: 4px; }.inspix-world-detail .project-cover { max-height: none; object-fit: contain; }.facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1px; margin: 0 0 70px; background: var(--line); border: 1px solid var(--line); }.facts div { padding: 20px; background: var(--paper); }.facts dt { color: var(--muted); font: 11px var(--mono); text-transform: uppercase; }.facts dd { margin: 7px 0 0; line-height: 1.5; }.project-detail section { margin-top: 72px; }.project-detail h2 { margin: 10px 0 24px; font-size: clamp(1.8rem, 4vw, 2.7rem); letter-spacing: -.05em; }.video-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 22px; }.video-item { min-width: 0; }.video iframe { width: 100%; aspect-ratio: 16 / 9; border: 0; border-radius: 4px; }.video-item h3 { margin: 14px 0 7px; }.video-item p { margin-bottom: 10px; color: var(--muted); line-height: 1.6; }.video-item a { font-size: 12px; font-weight: 800; text-decoration: underline; text-underline-offset: 4px; }.gallery { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 16px; }.gallery figure { margin: 0; }.gallery img { width: 100%; border-radius: 4px; }.gallery figcaption { color: var(--muted); font-size: .875rem; }.tech, .feature-grid, .challenges { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 12px; padding: 0; }.feature-grid-wide { grid-template-columns: repeat(2, minmax(0, 1fr)); }.tech { list-style: none; }.tech li, .feature-grid > div, .challenges article { padding: 28px; border: 1px solid var(--line); }.tech strong, .tech span { display: block; }.tech span, .feature-grid p, .challenges p { color: var(--muted); line-height: 1.65; }.feature-grid h3, .challenges h3 { margin-top: 0; }.story { max-width: 720px; }.case-study-story { max-width: 100%; }.story :global(p), .story :global(li) { color: #4e4f49; line-height: 1.85; }.story :global(h2) { margin-top: 2.1em; }.story :global(.implementation-note) { margin: 48px 0; padding: 28px 30px; border-left: 3px solid #a5aa92; background: #f2f2ec; }.story :global(.implementation-note h3) { margin: 4px 0 18px; }.story :global(.implementation-note p:last-child) { margin-bottom: 0; }.story :global(.note-label) { margin: 0; color: #74796b; font: 11px var(--mono); letter-spacing: .08em; text-transform: uppercase; }.story :global(.reflection) { margin-top: 48px; color: #74796b; }.story :global(.reflection h3), .story :global(.reflection p) { color: inherit; }.story :global(.story-media) { margin: 30px 0 42px; }.story :global(.story-media-narrow) { max-width: 520px; }.story :global(.story-media img) { display: block; width: 100%; max-height: 620px; border: 1px solid var(--line); border-radius: 4px; object-fit: contain; background: white; }.story :global(.story-media figcaption) { margin-top: 9px; color: var(--muted); font-size: .82rem; line-height: 1.55; }.story :global(.story-media-grid) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }.story :global(.story-media-grid .story-media) { margin: 30px 0 42px; }.links { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 56px; }
  @media (max-width: 640px) { .project-detail { padding-top: 36px; padding-bottom: 80px; }.project-detail header { padding: 44px 0 30px; }.project-detail section { margin-top: 54px; }.video-grid, .feature-grid-wide, .story :global(.story-media-grid) { grid-template-columns: 1fr; }.story :global(.story-media-grid .story-media) { margin-bottom: 0; } }
</style>
