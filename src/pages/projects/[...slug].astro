---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjectGroup } from '../../config/projectGroups';

export async function getStaticPaths() { return (await getCollection('projects', ({ data }) => !data.draft)).map((project) => ({ params: { slug: project.id }, props: { project } })); }
const { project } = Astro.props;
const { Content } = await render(project);
const { data } = project;
const projectGroup = getProjectGroup(data.projectGroup);
const isProjectR = project.id === 'project-r';
const isInspixWorld = project.id === 'inspix-world';
const isHiddenCheerSquad = project.id === 'the-hidden-cheer-squad';
const isBfx = project.id === 'bfx';
const isPersonalResearch = project.id === 'crowd-formation-control' || project.id === 'wind-map-simulation';
const usesCaseStudyLayout = isProjectR || isInspixWorld || isHiddenCheerSquad || isBfx || isPersonalResearch;
const showsRepresentativeMedia = !usesCaseStudyLayout || isHiddenCheerSquad || isPersonalResearch;
---
<BaseLayout title={data.title} description={data.summary}>
  <article class:list={["project-detail", "container", { "case-study-detail": usesCaseStudyLayout, "inspix-world-detail": isInspixWorld, "bfx-detail": isBfx }]}>
    <a class="back-link" href={projectGroup.href}>← {projectGroup.title}</a>
    <header><p class="eyebrow">{data.category === 'game' ? 'GAME' : 'GRAPHICS'} PROJECT {data.isExample && '· EXAMPLE'}</p><h1>{data.title}</h1><p class="lead">{data.description}</p></header>
    {data.thumbnail && <img class="project-cover" src={data.thumbnail} alt={`${data.title} 대표 이미지`} />}
    <dl class="facts">
      {data.period && <div><dt>기간</dt><dd>{data.period}</dd></div>}
      {data.role && <div><dt>역할</dt><dd>{data.role}</dd></div>}
      {(data.teamSize || data.team) && <div><dt>팀 규모</dt><dd>{data.teamSize ?? data.team}</dd></div>}
      {data.platform.length > 0 && <div><dt>플랫폼</dt><dd>{data.platform.join(' · ')}</dd></div>}
      {isBfx && <div><dt>상태</dt><dd>1차 개발 종료<br /><small>2차 개발 착수 계획 미정</small></dd></div>}
    </dl>
    {showsRepresentativeMedia && data.videos.length > 0 && <section aria-labelledby="project-videos"><p class="eyebrow">MEDIA</p><h2 id="project-videos">대표 미디어</h2><div class="video-grid">{data.videos.map((video) => <article class="video-item"><div class="video"><iframe src={`https://www.youtube-nocookie.com/embed/${video.youtubeId}`} title={video.title} loading="lazy" allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen /></div><h3>{video.title}</h3>{video.description && <p>{video.description}</p>}<a href={video.url} target="_blank" rel="noopener noreferrer">YouTube에서 보기 ↗</a></article>)}</div></section>}
    {!usesCaseStudyLayout && data.gallery.length > 0 && <section><h2>Gallery</h2><div class="gallery">{data.gallery.map((image) => <figure><img src={image.src} alt={image.alt} loading="lazy" />{image.caption && <figcaption>{image.caption}</figcaption>}</figure>)}</div></section>}
    {!usesCaseStudyLayout && <section><p class="eyebrow">TECH STACK</p><h2>사용 기술</h2><ul class="tech">{data.technologies.map((tech) => <li><strong>{tech.name}</strong><span>{tech.purpose}</span></li>)}</ul></section>}
    {!isBfx && <section><p class="eyebrow">CONTRIBUTION</p><h2>{usesCaseStudyLayout ? '구현 및 기여' : '본인 기여 · 핵심 구현'}</h2><div class:list={["feature-grid", { "feature-grid-wide": usesCaseStudyLayout }]}>{data.features.map((feature) => <div><h3>{feature.title}</h3><p>{feature.description}</p></div>)}</div></section>}
    {!usesCaseStudyLayout && data.challenges.length > 0 && <section><h2>문제 해결</h2><div class="challenges">{data.challenges.map((item) => <article><h3>{item.problem}</h3><p><strong>해결:</strong> {item.solution}</p>{item.result && <p><strong>결과:</strong> {item.result}</p>}</article>)}</div></section>}
    <section class:list={["story", { "case-study-story": usesCaseStudyLayout }]}><Content /></section>
    <div class="links">{data.repositoryUrl && <a class="button button-primary" href={data.repositoryUrl} target="_blank" rel="noreferrer">GitHub ↗</a>}{data.playableUrl && <a class="button button-outline" href={data.playableUrl} target="_blank" rel="noreferrer">실행·다운로드 ↗</a>}{data.notionUrl && <a class="button button-outline" href={data.notionUrl} target="_blank" rel="noreferrer">Notion 기록 ↗</a>}{data.externalLinks.map((link) => <a class="button button-outline" href={link.url} target="_blank" rel="noreferrer">{link.label} ↗</a>)}</div>
  </article>
</BaseLayout>

<style>
  .project-detail { padding-top: 64px; padding-bottom: 120px; }.project-detail header { padding: 72px 0 44px; }.project-detail h1 { max-width: 100%; }.lead { max-width: 720px; color: var(--muted); font-size: 1.2rem; line-height: 1.75; word-break: keep-all; overflow-wrap: break-word; }.case-study-detail .lead { max-width: none; }.project-cover { width: 100%; max-height: 560px; object-fit: cover; border-radius: 4px; }.inspix-world-detail .project-cover { max-height: none; object-fit: contain; }.facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1px; margin: 0 0 70px; background: var(--line); border: 1px solid var(--line); }.facts div { padding: 20px; background: var(--paper); }.facts dt { color: var(--muted); font: 11px var(--mono); text-transform: uppercase; }.facts dd { margin: 7px 0 0; line-height: 1.5; }.project-detail section { margin-top: 72px; }.project-detail h2 { margin: 10px 0 24px; font-size: clamp(1.8rem, 4vw, 2.7rem); letter-spacing: -.05em; }.video-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 22px; }.video-item { min-width: 0; }.video iframe { width: 100%; aspect-ratio: 16 / 9; border: 0; border-radius: 4px; }.video-item h3 { margin: 14px 0 7px; }.video-item p { margin-bottom: 10px; color: var(--muted); line-height: 1.6; }.video-item a { font-size: 12px; font-weight: 800; text-decoration: underline; text-underline-offset: 4px; }.gallery { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 16px; }.gallery figure { margin: 0; }.gallery img { width: 100%; border-radius: 4px; }.gallery figcaption { color: var(--muted); font-size: .875rem; }.tech, .feature-grid, .challenges { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 12px; padding: 0; }.feature-grid-wide { grid-template-columns: repeat(2, minmax(0, 1fr)); }.tech { list-style: none; }.tech li, .feature-grid > div, .challenges article { padding: 28px; border: 1px solid var(--line); background:var(--surface); }.tech strong, .tech span { display: block; }.tech span, .feature-grid p, .challenges p { color: var(--muted); line-height: 1.65; }.feature-grid h3, .challenges h3 { margin-top: 0; }.story { max-width: var(--content-width); }.story :global(p), .story :global(li) { color: var(--body-copy); line-height: 1.85; }.story :global(h2) { margin-top: 2.1em; }.story :global(.implementation-note) { margin: 48px 0; padding: 28px 30px; border-left: 3px solid var(--accent); background: var(--surface-note); }.story :global(.implementation-note h3) { margin: 4px 0 18px; }.story :global(.implementation-note p:last-child) { margin-bottom: 0; }.story :global(.note-label) { margin: 0; color: var(--muted); font: 11px var(--mono); letter-spacing: .08em; text-transform: uppercase; }.story :global(.reflection) { margin-top: 48px; color: var(--muted); }.story :global(.reflection h3), .story :global(.reflection p) { color: inherit; }.story :global(.story-media) { margin: 30px 0 42px; }.story :global(.story-media-narrow) { max-width: 520px; }.story :global(.story-media img) { display: block; width: 100%; max-height: 620px; border: 1px solid var(--line); border-radius: 4px; object-fit: contain; background: var(--image-frame); }.story :global(.story-media figcaption) { margin-top: 9px; color: var(--muted); font-size: .82rem; line-height: 1.55; }.story :global(.story-media-grid) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }.story :global(.story-media-grid .story-media) { margin: 30px 0 42px; }.links { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 56px; }
  .bfx-detail .project-cover { max-height: none; aspect-ratio: auto; object-fit: contain; }
  .bfx-detail { padding-top: 36px; }
  .bfx-detail > .back-link { margin-bottom: 24px; }
  .bfx-detail > header { padding: 28px 0 32px; }
  .bfx-detail > header h1 { margin-top: 12px; margin-bottom: 18px; }
  .bfx-detail > header .lead { max-width: 100%; }
  .bfx-detail > .facts { margin-bottom: 28px; }
  .bfx-detail > .story { margin-top: 34px; }
  .bfx-detail .facts small { color: var(--muted); font-size: .76rem; }
  .story :global(#빌드-자동화), .story :global(#overview), .story :global(#features), .story :global(#ai-usage), .story :global(.bfx-feature), .story :global(.bfx-ai-case) { scroll-margin-top: 110px; }
  .story :global(#overview), .story :global(#features), .story :global(#ai-usage) { margin-top: 2.15em; font-size: clamp(2.15rem, 4.6vw, 3.15rem); line-height: 1.08; }
  .story :global(.bfx-intro-grid) { max-width: 100%; }
  .story :global(.bfx-intro-grid h2) { margin: 8px 0 22px; font-size: clamp(1.8rem, 4vw, 3rem); }
  .story :global(.bfx-kicker), .story :global(.bfx-case-number) { color: var(--accent); font: 700 11px var(--mono); letter-spacing: .08em; }
  .story :global(.bfx-video video) { display: block; width: 100%; aspect-ratio: 16 / 9; border: 1px solid var(--line); border-radius: 4px; background: #000; }
  .story :global(.bfx-case) { margin: 0; padding: 46px 0; border: 0; border-top: 1px solid var(--line); background: transparent; }
  .story :global(#quest-dialogue), .story :global(#ai-workbook) { border-top: 0; }
  .story :global(.bfx-case > header) { padding: 0; }
  .story :global(.bfx-case > header h3) { max-width: 100%; margin: 8px 0 10px; font-size: clamp(1.3rem, 2.2vw, 1.7rem); letter-spacing: -.02em; }
  .story :global(.bfx-case > header p) { max-width: 100%; }
  .story :global(.bfx-case > header .bfx-case-lead) { margin-bottom: 14px; color: var(--ink); font-size: 1.02rem; font-weight: 700; line-height: 1.65; }
  .story :global(.bfx-decision-grid) { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; margin: 30px 0; border: 1px solid var(--line); background: var(--line); }
  .story :global(.bfx-decision-grid > div) { padding: 22px; background: var(--paper); }
  .story :global(.bfx-decision-grid span) { display: block; margin-bottom: 9px; color: var(--accent); font-size: .76rem; font-weight: 800; }
  .story :global(.bfx-decision-grid p) { margin: 0; font-size: .92rem; line-height: 1.7; }
  .story :global(.bfx-flow) { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin: 30px 0; }
  .story :global(.bfx-flow > div) { position: relative; padding: 24px; border: 1px solid var(--line); background: var(--paper); }
  .story :global(.bfx-flow span) { display: grid; place-items: center; width: 28px; height: 28px; margin-bottom: 18px; border-radius: 50%; background: var(--button-bg); color: var(--button-text); font: 700 11px var(--mono); }
  .story :global(.bfx-flow strong) { display: block; }
  .story :global(.bfx-flow p) { margin: 8px 0 0; font-size: .86rem; }
  .story :global(.bfx-notification-list) { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; margin: 28px 0 8px; border: 1px solid var(--line); background: var(--line); }
  .story :global(.bfx-notification-list > div) { padding: 18px 20px; background: var(--paper); }
  .story :global(.bfx-notification-list strong), .story :global(.bfx-notification-list span) { display: block; }
  .story :global(.bfx-notification-list span) { margin-top: 5px; color: var(--muted); font-size: .84rem; line-height: 1.55; }
  .story :global(.bfx-panel-summary) { align-self: center; padding: 28px; border: 1px solid var(--line); background: var(--paper); }
  .story :global(.bfx-panel-summary ul) { padding-left: 20px; }
  .story :global(.bfx-ai-lead) { max-width: 100%; font-size: 1.08rem; }
  .story :global(.bfx-ai-process) { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; margin: 28px 0 46px; border: 1px solid var(--line); background: var(--line); }
  .story :global(.bfx-ai-process > div) { padding: 22px; background: var(--surface); }
  .story :global(.bfx-ai-process span) { color: var(--accent); font: 700 11px var(--mono); }
  .story :global(.bfx-ai-process strong) { display: block; margin-top: 12px; }
  .story :global(.bfx-ai-process p) { margin: 8px 0 0; font-size: .84rem; line-height: 1.65; }
  .story :global(.bfx-ai-case) { padding-left: 0; }
  .story :global(.bfx-proof > div > img) { display: block; width: 100%; max-height: 620px; border: 1px solid var(--line); object-fit: contain; background: var(--image-frame); }
  .story :global(.bfx-case blockquote) { margin: 30px 0; padding: 24px 28px; border-left: 3px solid var(--accent); background: var(--surface-note); color: var(--ink); font-size: 1.05rem; line-height: 1.75; }
  .story :global(.bfx-case cite) { display: block; margin-top: 12px; color: var(--muted); font-size: .75rem; font-style: normal; }
  .story :global(.bfx-evidence-pair img) { aspect-ratio: 16 / 9; object-fit: contain; }
  .story :global(.bfx-proof) { margin-top: 18px; border: 1px solid var(--interactive-line); background: var(--paper); }
  .story :global(.bfx-proof summary) { padding: 18px 20px; cursor: pointer; color: var(--ink); font-size: .86rem; font-weight: 800; }
  .story :global(.bfx-proof summary:hover) { color: var(--accent); }
  .story :global(.bfx-proof > div) { padding: 0 20px 22px; }
  .story :global(.bfx-proof-grid) { display: grid; grid-template-columns: minmax(240px, .8fr) minmax(0, 1.2fr); gap: 24px; }
  .story :global(.bfx-proof-grid > *), .story :global(.bfx-decision-grid > *), .story :global(.bfx-support-grid > *) { min-width: 0; }
  .story :global(.bfx-proof-grid figure) { margin: 0; }
  .story :global(.bfx-proof-grid img) { width: 100%; border: 1px solid var(--line); background: var(--image-frame); }
  .story :global(.bfx-proof-grid figcaption) { margin-top: 8px; color: var(--muted); font-size: .76rem; }
  .story :global(pre) { max-width: 100%; overflow-x: auto; padding: 18px; border: 1px solid var(--line); background: var(--surface-strong); color: var(--body-copy); font: 12px/1.7 var(--mono); }
  .story :global(p code), .story :global(li code) { overflow-wrap: anywhere; word-break: break-word; }
  .story :global(.bfx-limit) { color: var(--muted); font-size: .82rem; }
  .story :global(.bfx-support-grid) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .story :global(.bfx-support-grid > article) { padding: 28px; border: 1px solid var(--line); background: var(--surface); }
  .story :global(.bfx-support-grid h3) { margin: 10px 0 14px; }
  .story :global(.bfx-ui-grid img) { aspect-ratio: 16 / 9; object-fit: contain; }
  .story :global(.bfx-importer-media) { max-width: 680px; }
  .story :global(.bfx-importer-media a) { display: block; }
  .story :global(.bfx-importer-media img) { max-height: 560px; cursor: zoom-in; }
  .story :global(.bfx-callout) { margin-top: 28px; padding: 24px 26px; border-left: 3px solid var(--accent); background: var(--surface-note); }
  .story :global(.bfx-callout span) { display: block; margin-bottom: 8px; color: var(--accent); font-size: .78rem; font-weight: 800; }
  .story :global(.bfx-callout p) { margin: 0; }
  .story :global(.bfx-notification-media) { display: grid; gap: 34px; max-width: var(--content-width); }
  .story :global(.bfx-notification-media .story-media) { margin: 28px 0 0; }
  .story :global(.bfx-notification-media img) { width: 100%; border: 1px solid var(--line); border-radius: 4px; }
  .story :global(.bfx-popup-note) { max-width: 100%; margin-top: 34px; padding-top: 30px; border-top: 1px dashed var(--line); }
  .story :global(.bfx-popup-note h4) { margin: 0 0 14px; font-size: 1.15rem; }
  .story :global(.bfx-popup-note p:last-child) { margin-bottom: 0; }
  .story :global(.bfx-feature-extension) { margin-top: 44px; padding-top: 32px; border-top: 1px dashed var(--line); }
  .story :global(.bfx-feature-extension h4) { margin: 0 0 10px; font-size: 1.15rem; }
  .story :global(.bfx-feature-extension .bfx-case-lead) { margin-bottom: 12px; color: var(--ink); font-weight: 700; }
  .story :global(.bfx-media-note) { max-width: 820px; margin: 34px 0 0; color: var(--muted); font-size: .82rem; }
  .story :global(.bfx-proof-compact) { margin-top: 0; }
  .story :global(.bfx-file-links) { display: flex; flex-wrap: wrap; gap: 10px; }
  .story :global(.bfx-file-links a) { padding: 12px 14px; border: 1px solid var(--interactive-line); border-radius: 4px; background: var(--surface); font-size: .82rem; font-weight: 800; }
  .story :global(.bfx-file-links a:hover) { border-color: var(--accent); color: var(--accent); }
  .story :global(.bfx-boundaries) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; border: 1px solid var(--line); background: var(--line); }
  .story :global(.bfx-boundary-title) { margin: 58px 0 18px; font-size: 1.25rem; }
  .story :global(.bfx-boundaries p) { margin: 0; padding: 22px; background: var(--surface); font-size: .9rem; }
  @media (max-width: 640px) { .project-detail { padding-top: 36px; padding-bottom: 80px; }.project-detail header { padding: 44px 0 30px; }.project-detail section { margin-top: 54px; }.video-grid, .feature-grid-wide, .story :global(.story-media-grid) { grid-template-columns: 1fr; }.story :global(.story-media-grid .story-media) { margin-bottom: 0; } }
  @media (max-width: 760px) { .bfx-detail { padding-top: 24px; }.bfx-detail > .back-link { margin-bottom: 14px; }.bfx-detail > header { padding: 22px 0 26px; }.bfx-detail > .facts { margin-bottom: 18px; }.bfx-detail > .story { margin-top: 24px; }.story :global(.bfx-intro-grid), .story :global(.bfx-decision-grid), .story :global(.bfx-flow), .story :global(.bfx-proof-grid), .story :global(.bfx-support-grid), .story :global(.bfx-boundaries), .story :global(.bfx-ai-process) { grid-template-columns: minmax(0, 1fr); }.story :global(.bfx-notification-list) { grid-template-columns: 1fr; }.story :global(.bfx-case) { overflow: hidden; padding: 36px 0; }.story :global(.bfx-case blockquote) { padding: 20px; }.story :global(.bfx-proof > div) { padding-right: 16px; padding-left: 16px; }.story :global(.bfx-file-links) { flex-direction: column; }.story :global(.bfx-file-links a) { text-align: center; } }
</style>
