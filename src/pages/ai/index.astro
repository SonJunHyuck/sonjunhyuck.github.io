---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCarousel from '../../components/ProjectCarousel.astro';
import ProjectShowcase from '../../components/ProjectShowcase.astro';
import { getOrderedProjects, getProjectListItems } from '../../lib/projects';

const projects = getProjectListItems(await getOrderedProjects('ai'));
---
<BaseLayout title="AI 협업 — Son Junhyuck" description="AI와 함께 만든 프로젝트를 소개합니다." next={{ href: '/profile/', title: '프로필', image: '/profile.webp' }}>
  <h1 class="visually-hidden">AI 협업</h1>
  {projects.length > 0 && (
    <>
      <ProjectCarousel {projects} />
      <ProjectShowcase {projects} label="AI 협업 프로젝트 소개" />
    </>
  )}
  <section class="container ai-workspace" aria-labelledby="workspace-title">
    <div class="workspace-media">
      <img src="/images/ai/multi-agent-relay.gif" width="1400" height="975" alt="herdr에서 Claude Code와 두 Codex가 작업 메시지를 주고받는 터미널 녹화" loading="lazy" decoding="async" />
      <div class="workspace-heading">
        <p class="eyebrow">WORKFLOW</p>
        <h2 id="workspace-title">작업 환경</h2>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .ai-workspace { padding-block: clamp(32px, 5vw, 64px) clamp(48px, 7vw, 96px); border-top: 1px solid var(--line); }
  .workspace-media {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: var(--media-neutral);
  }
  .workspace-media img { display: block; width: 100%; height: auto; }
  .workspace-heading {
    position: absolute;
    inset: 0 0 auto;
    display: grid;
    justify-items: center;
    gap: 4px;
    padding: clamp(10px, 1.15vw, 16px) 16px clamp(12px, 1.2vw, 18px);
    background: linear-gradient(180deg, rgb(0 0 0 / .74), rgb(0 0 0 / .58) 82%, transparent);
    color: #fff;
    text-align: center;
  }
  .workspace-heading .eyebrow { color: inherit; }
  .workspace-heading h2 {
    margin: 0;
    font-size: clamp(1.5rem, 3.6vw, 2.75rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -.045em;
  }
  @media (max-width: 680px) {
    .workspace-media { border-radius: 16px; }
  }
</style>
