---
import BaseLayout from '../layouts/BaseLayout.astro';
import TagList from '../components/TagList.astro';

const experience = [
  {
    company: '보이저',
    role: '클라이언트 개발',
    period: '2025.04–2026.03',
    tech: ['Unity', 'C#', 'Jenkins', 'AWS S3'],
    projects: [
      {
        name: 'Project R',
        description: 'Unity 기반 신규 3D MMORPG',
        contributions: [
          'Jenkins를 활용한 클라이언트 빌드·배포 자동화',
          '네트워크 동기화를 포함한 감정표현 기능과 관련 UI 구현',
          '무한 스크롤과 반응형 데이터 갱신을 적용한 상점 UI 구현',
        ],
      },
      {
        name: 'Inspix World · BattleRoyal',
        description: '라이브 서비스 어트랙션',
        contributions: [
          '라이브 이슈 원인 분석·수정 및 업데이트 대응',
          '파트너사와 서버·클라이언트 담당자 사이의 이슈 및 운영 절차 조율',
          '클라이언트 빌드, 에셋번들 패치, 서버 오픈 절차를 온보딩 가이드로 문서화',
        ],
      },
    ],
  },
  {
    company: '갈라랩',
    role: '클라이언트 개발',
    period: '2015.12–2017.02',
    tech: ['Unity', 'C#'],
    projects: [
      {
        name: '프리프 레거시',
        description: 'Unity 기반 모바일 MMORPG',
        contributions: [
          '콘텐츠 UI 기능과 서버 트랜잭션 연동',
          '게임플레이 기능 구현 보조',
          '클라이언트 최적화 적용',
        ],
      },
    ],
  },
];

const skills = ['Unity', 'C#', 'Jenkins', 'AWS S3', 'C++', 'OpenGL', 'Compute Shader'];
---

<BaseLayout title="About — Son Junhyuck" description="Son Junhyuck의 이력, 역량, 활동을 정리한 게임 개발 포트폴리오">
  <section class="about-hero">
    <div class="container hero-layout">
      <div class="hero-content">
        <p class="eyebrow hero-role"><span aria-hidden="true">✦</span> GAME CLIENT DEVELOPER</p>
        <h1>안녕하세요,<br /><em>손준혁</em>입니다.</h1>
        <ul class="hero-intro">
          <li>Unity·C#으로 콘텐츠 UI와 게임의 상호작용을 구현합니다.</li>
          <li>문제의 원인을 분석하고 개발·운영 과정을 개선합니다.</li>
          <li>유연한 협업을 바탕으로 안정적인 라이브 서비스를 만들어갑니다.</li>
        </ul>
        <TagList tags={skills} label="주요 기술" />
        <div class="hero-links">
          <a href="mailto:s.junhyuck@gmail.com" aria-label="손준혁에게 이메일 보내기">Email <span>↗</span></a>
          <a href="https://github.com/SonJunHyuck" target="_blank" rel="noreferrer" aria-label="손준혁 GitHub 방문">GitHub <span>↗</span></a>
        </div>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <span class="hero-orbit"></span>
        <span class="hero-monogram">SJ</span>
        <span class="hero-spark hero-spark-one">✦</span>
        <span class="hero-spark hero-spark-two">✦</span>
      </div>
    </div>
  </section>

  <div class="resume container">
    <aside class="resume-index" aria-label="소개 페이지 목차">
      <a href="#experience">Experience</a><a href="#education">Education</a><a href="#activities">Activities</a><a href="#contact">Contact</a>
    </aside>
    <div class="resume-content">
      <section id="experience" class="resume-section">
        <p class="eyebrow">EXPERIENCE</p>
        <h2>이력 · 경력기술</h2>
        <div class="experience-list">
          {experience.map((item) => (
            <article class="experience-item">
              <span class="timeline-dot" aria-hidden="true"></span>
              <header class="resume-item-header">
                <div><h3>{item.company}</h3><p class="experience-role">{item.role}</p></div>
                <p class="resume-period">{item.period}</p>
              </header>
              <div class="project-contributions">
                {item.projects.map((project) => (
                  <section class="contribution-group">
                    <h4>{project.name}</h4>
                    <p>{project.description}</p>
                    <ul>{project.contributions.map((contribution) => <li>{contribution}</li>)}</ul>
                  </section>
                ))}
              </div>
              <div class="experience-tech">
                <p>Tech Stack</p>
                <TagList tags={item.tech} label={`${item.company} 기술 스택`} />
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="education" class="resume-section">
        <p class="eyebrow">EDUCATION</p>
        <h2>학력</h2>
        <div class="resume-list">
          <article class="resume-list-item">
            <div><h3>계명대학교 대학원</h3><p>컴퓨터공학과 석사 · 컴퓨터 그래픽스 연구실 군중 시뮬레이션 연구</p></div>
            <p class="resume-period">2021.08–2023.08 · 졸업</p>
          </article>
          <article class="resume-list-item">
            <div><h3>계명대학교</h3><p>게임모바일콘텐츠학과 학사</p></div>
            <p class="resume-period">2012.03–2020.08 · 졸업</p>
          </article>
        </div>
      </section>

      <section id="activities" class="resume-section">
        <p class="eyebrow">ACTIVITIES</p>
        <h2>활동 · 자격</h2>
        <div class="resume-list">
          <article class="resume-list-item">
            <div><h3>VR 우주 시뮬레이션 · 팀 프로젝트 최우수상</h3><p>모션 인식 기기와 HMD를 Unity에 접목한 체험형 프로젝트</p></div>
            <p class="resume-period">2014</p>
          </article>
          <article class="resume-list-item"><div><h3>정보처리산업기사</h3><p>국가기술자격</p></div><p class="resume-period">2016.05</p></article>
        </div>
      </section>

      <section id="contact" class="resume-section contact-section">
        <p class="eyebrow">CONTACT</p>
        <h2>연락처</h2>
        <p>업무 문의는 이메일로 연락해 주세요. GitHub에서 공개 작업과 코드를 확인할 수 있습니다.</p>
        <div class="contact-links">
          <a class="button button-primary" href="mailto:s.junhyuck@gmail.com">이메일 보내기 <span>↗</span></a>
          <a class="button button-outline" href="https://github.com/SonJunHyuck" target="_blank" rel="noreferrer">GitHub 방문 <span>↗</span></a>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
