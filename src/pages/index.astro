---
import BaseLayout from '../layouts/BaseLayout.astro';
import { posts } from '../data/posts';
---

<BaseLayout title="Sonny Smile — Portfolio & Devlog">
  <section class="hero container">
    <p class="eyebrow">PORTFOLIO · DEVLOG</p>
    <h1>작은 아이디어를<br /><em>선명한 경험</em>으로 만듭니다.</h1>
    <p class="hero-copy">Sonny Smile은 웹을 만들고, 관찰하고, 기록합니다. 보기 좋은 화면 너머의 쓰임과 감각을 고민합니다.</p>
    <div class="actions">
      <a class="button button-primary" href="/projects/">프로젝트 보기 <span>↗</span></a>
      <a class="text-link" href="/about/">저는 이런 사람입니다 <span>→</span></a>
    </div>
  </section>

  <section class="container section">
    <div class="section-heading">
      <div><p class="eyebrow">SELECTED WORK</p><h2>최근 프로젝트</h2></div>
      <a class="text-link" href="/projects/">모두 보기 <span>→</span></a>
    </div>
    <div class="project-grid">
      <article class="project-card project-sun"><p>01 / WEB EXPERIENCE</p><div><h3>Daily Momentum</h3><span>습관을 이어가는 가장 가벼운 방법</span></div></article>
      <article class="project-card project-blue"><p>02 / DIGITAL PRODUCT</p><div><h3>Local Letter</h3><span>동네의 이야기를 모으는 뉴스레터</span></div></article>
    </div>
  </section>

  <section class="container section journal-section">
    <div class="section-heading"><div><p class="eyebrow">FROM THE DEVLOG</p><h2>생각과 기록</h2></div><a class="text-link" href="/posts/">글 전체 보기 <span>→</span></a></div>
    <div class="post-list">
      {posts.slice(0, 2).map((post) => <a class="post-row" href={`/posts/${post.slug}/`}><span class="post-meta">{post.tag} · {post.date}</span><h3>{post.title}</h3><span aria-hidden="true">↗</span></a>)}
    </div>
  </section>
</BaseLayout>
