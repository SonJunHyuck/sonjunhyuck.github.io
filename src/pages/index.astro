---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLandingCards } from '../lib/landing';
import '../styles/landing.css';
const cards = await getLandingCards();
const middle = Math.floor(cards.length / 2);
const fanCenter = (cards.length - 1) / 2;
---
<BaseLayout title="Son Junhyuck — 포트폴리오" description="프로필, 하이라이트, 프로젝트, AI 협업에서 손준혁의 이력과 개발 경험을 둘러보세요.">
  <section class="landing-shell container" data-landing data-active-id={cards[middle]?.id} aria-labelledby="landing-title">
    <h1 id="landing-title" class="visually-hidden">손준혁 포트폴리오 — 둘러볼 페이지 선택</h1>
    <nav class="landing-hand" aria-label="둘러볼 페이지 선택">
      <ul class="landing-stage" data-landing-stage>
        {cards.map((card, index) => <li class="landing-slot" style={{ '--slot': index - fanCenter, '--depth': Math.abs(index - fanCenter), '--order': index, 'z-index': index === middle ? cards.length + 10 : cards.length - Math.floor(Math.abs(index - fanCenter)) }} data-landing-slot={index} data-raised={index === middle}>
          <a class="landing-card" href={card.href} data-landing-card={card.id} data-title={card.title} style={{ '--image-fit': card.imageFit ?? 'cover', '--image-position': card.imagePosition ?? 'center' }}>
            <div class="landing-media">
              {card.image ? <img src={card.image.src} alt={card.image.alt} width="640" height="640" decoding="async" fetchpriority="high" /> : <span aria-hidden="true">{card.title}</span>}
            </div>
            <div class="landing-card-copy"><h2>{card.title}</h2><p>{card.description}</p></div>
          </a>
        </li>)}
      </ul>
    </nav>
    <div class="landing-mobile-ui">
      <p class="landing-selection" data-landing-status role="status" aria-live="polite" aria-atomic="true">{cards[middle]?.title} · {middle + 1} / {cards.length}</p>
      <p class="landing-gesture-hint">좌우로 밀거나 옆 카드를 눌러 보세요.</p>
    </div>
  </section>
</BaseLayout>
<script>
  import '../scripts/landing';
</script>
