-using System;
-using System.Reflection;
-using PixelCrushers.DialogueSystem;
-using UnityEngine;
-
-namespace BFX
-{
-    /// <summary>
-    /// Dialogue System Lua 함수와 시퀀스 공개 API를 연결한다.
-    /// </summary>
-    [DisallowMultipleComponent]
-    public sealed class SequenceDialogueBridge : MonoBehaviour
-    {
-        private const string IsCompletedFunctionName = "BfxSequenceIsCompleted";
-        private const string StartFunctionName = "BfxStartSequence";
-        private const string CompleteFunctionName = "BfxCompleteSequence";
-        private const string SetCurrentBeatFunctionName = "BfxSetSequenceBeat";
-
-        private static readonly string[] LuaFunctionNames =
-        {
-            IsCompletedFunctionName,
-            StartFunctionName,
-            CompleteFunctionName,
-            SetCurrentBeatFunctionName
-        };
-
-        private void OnEnable()
-        {
-            RegisterLuaFunctions();
-        }
-
-        private void Start()
-        {
-            RegisterLuaFunctions();
-        }
-
-        private void OnDisable()
-        {
-            UnregisterLuaFunctions();
-        }
-
-        /// <summary>
-        /// 지정한 시퀀스가 완료됐는지 반환한다.
-        /// </summary>
-        public bool BfxSequenceIsCompleted(string sequenceId)
-        {
-            return IsValidId(sequenceId) && SequenceManager.Instance.IsCompleted(sequenceId);
-        }
-
-        /// <summary>
-        /// 지정한 시퀀스를 진행 상태로 기록하고 성공 여부를 반환한다.
-        /// </summary>
-        public bool BfxStartSequence(string sequenceId)
-        {
-            return IsValidId(sequenceId) && SequenceManager.Instance.StartSequence(sequenceId);
-        }
-
-        /// <summary>
-        /// 지정한 시퀀스를 완료 처리하고 성공 여부를 반환한다.
-        /// </summary>
-        public bool BfxCompleteSequence(string sequenceId)
-        {
-            return IsValidId(sequenceId) && SequenceManager.Instance.CompleteSequence(sequenceId);
-        }
-
-        /// <summary>
-        /// 지정한 시퀀스의 현재 Beat를 갱신하고 성공 여부를 반환한다.
-        /// </summary>
-        public bool BfxSetSequenceBeat(string sequenceId, string beatId)
-        {
-            return IsValidId(sequenceId) &&
-                   IsValidId(beatId) &&
-                   SequenceManager.Instance.SetCurrentBeat(sequenceId, beatId);
-        }
-
-        private void RegisterLuaFunctions()
-        {
-            UnregisterLuaFunctions();
-            RegisterLuaFunction(IsCompletedFunctionName, nameof(BfxSequenceIsCompleted));
-            RegisterLuaFunction(StartFunctionName, nameof(BfxStartSequence));
-            RegisterLuaFunction(CompleteFunctionName, nameof(BfxCompleteSequence));
-            RegisterLuaFunction(SetCurrentBeatFunctionName, nameof(BfxSetSequenceBeat));
-        }
-
-        private void RegisterLuaFunction(string luaFunctionName, string methodName)
-        {
-            MethodInfo method = GetType().GetMethod(methodName, BindingFlags.Instance | BindingFlags.Public);
-            if (method == null)
-            {
-                Debug.LogError($"[Sequence] Dialogue bridge method not found: {methodName}");
-                return;
-            }
-
-            Lua.RegisterFunction(luaFunctionName, this, method);
-        }
-
-        private void UnregisterLuaFunctions()
-        {
-            foreach (string luaFunctionName in LuaFunctionNames)
-            {
-                Lua.UnregisterFunction(luaFunctionName);
-            }
-        }
-
-        private static bool IsValidId(string id)
-        {
-            return !string.IsNullOrWhiteSpace(id);
-        }
-    }
-}
