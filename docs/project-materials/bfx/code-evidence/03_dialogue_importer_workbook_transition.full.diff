+        /// <summary>
+        /// Source가 마지막으로 임포트한 Conversation을 Database에서 제거한다.
+        /// </summary>
+        public static int RemoveImportedConversations(DialogueImportProfile profile, DialogueImportSource source)
+        {
+            if (profile == null || profile.database == null || source == null || source.importedConversationIds == null)
+            {
+                return 0;
+            }
+
+            Undo.RecordObject(profile, "Remove Imported Dialogue");
+            Undo.RecordObject(profile.database, "Remove Imported Dialogue");
+
+            int removedCount = 0;
+            for (int conversationIndex = 0; conversationIndex < source.importedConversationIds.Count; conversationIndex++)
+            {
+                if (RemoveConversation(profile.database, source.importedConversationIds[conversationIndex]))
+                {
+                    removedCount++;
+                }
+            }
+
+            source.importedConversationIds.Clear();
+            profile.database.ResetCache();
+            EditorUtility.SetDirty(profile);
+            EditorUtility.SetDirty(profile.database);
+            AssetDatabase.SaveAssets();
+            return removedCount;
+        }
